<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gambar Full Screen dengan Bingkai</title>
  <style>
    /* Reset margin & padding dasar */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #0f1016; /* Latar belakang gelap yang elegan */
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: system-ui, -apple-system, sans-serif;
    }

    /* Container untuk Bingkai */
    .frame-container {
      position: relative;
      width: calc(100vw - 40px);  /* Ukuran menyesuaikan layar dikurangi area bingkai */
      height: calc(100vh - 40px);
      border-radius: 20px;
      padding: 12px;              /* Ketebalan bingkai bagian dalam */
      
      /* Efek Bingkai Degradasi Mewah (Gradient Border) */
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.25));
      
      /* Efek Bayangan (Glow & Shadow) */
      box-shadow: 
        0 20px 40px rgba(0, 0, 0, 0.6),
        0 0 30px rgba(255, 255, 255, 0.08);

      /* Efek Kaca Buram di Belakang Bingkai */
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    /* Wadah Gambar di Dalam Bingkai */
    .img-wrapper {
      width: 100%;
      height: 100%;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      background-color: #000;
    }

    /* Elemen Gambar */
    .fullscreen-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transition: transform 0.5s ease;
    }

    /* Efek hover halus pada gambar */
    .frame-container:hover .fullscreen-img {
      transform: scale(1.02);
    }

    /* Hiasan Sudut Elegan (Aksen Bingkai Tambahan) */
    .frame-container::before,
    .frame-container::after {
      content: '';
      position: absolute;
      width: 30px;
      height: 30px;
      border-color: rgba(255, 255, 255, 0.6);
      border-style: solid;
      pointer-events: none;
      z-index: 2;
    }

    /* Sudut Kiri Atas */
    .frame-container::before {
      top: -2px;
      left: -2px;
      border-width: 3px 0 0 3px;
      border-top-left-radius: 22px;
    }

    /* Sudut Kanan Bawah */
    .frame-container::after {
      bottom: -2px;
      right: -2px;
      border-width: 0 3px 3px 0;
      border-bottom-right-radius: 22px;
    }

    /* Responsi untuk layar HP agar padding bingkai menyesuaikan */
    @media (max-width: 600px) {
      .frame-container {
        width: calc(100vw - 20px);
        height: calc(100vh - 20px);
        padding: 8px;
        border-radius: 16px;
      }
    }
  </style>
</head>
<body>

  <div class="frame-container">
    <div class="img-wrapper">
      <!-- Ganti URL_GAMBAR_ANDA.jpg dengan lokasi/URL gambar kamu -->
      <img src="https://mvlrfq.github.io/Rafa/DSC_1119.jpeg" alt="Gambar Full Screen" class="fullscreen-img">
    </div>
  </div>

</body>
</html>
