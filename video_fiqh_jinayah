<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tampilan Foto Fullscreen</title>
  <style>
    /* Reset CSS dasar */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #0b0f19; /* Latar belakang gelap modern */
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: system-ui, -apple-system, sans-serif;
    }

    /* Container Utama Bingkai */
    .frame-container {
      position: relative;
      width: calc(100vw - 32px);
      height: calc(100vh - 32px);
      max-width: 1200px;
      max-height: 900px;
      border-radius: 20px;
      padding: 10px;
      
      /* Gradient Border Gold/Emas Mewah */
      background: linear-gradient(135deg, #f39c12, rgba(255, 255, 255, 0.1), #e67e22);
      
      /* Bayangan Halus / Glow Effect */
      box-shadow: 
        0 20px 50px rgba(0, 0, 0, 0.8),
        0 0 25px rgba(243, 156, 18, 0.3);
    }

    /* Area Dalam Gambar */
    .img-wrapper {
      width: 100%;
      height: 100%;
      border-radius: 12px;
      overflow: hidden;
      background-color: #1a1a1a;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Pengaturan Elemen Gambar */
    .fullscreen-img {
      width: 100%;
      height: 100%;
      object-fit: contain; /* Menggunakan 'contain' agar foto utuh tidak terpotong */
      object-position: center;
      display: block;
      transition: transform 0.4s ease;
    }

    /* Efek Hover Halus */
    .frame-container:hover .fullscreen-img {
      transform: scale(1.02);
    }

    /* Aksen Sudut Bingkai Tambahan */
    .frame-container::before,
    .frame-container::after {
      content: '';
      position: absolute;
      width: 25px;
      height: 25px;
      border-color: #f39c12;
      border-style: solid;
      pointer-events: none;
      z-index: 2;
    }

    .frame-container::before {
      top: -2px;
      left: -2px;
      border-width: 3px 0 0 3px;
      border-top-left-radius: 22px;
    }

    .frame-container::after {
      bottom: -2px;
      right: -2px;
      border-width: 0 3px 3px 0;
      border-bottom-right-radius: 22px;
    }

    /* Penyesuaian Tampilan Layar HP */
    @media (max-width: 600px) {
      .frame-container {
        width: calc(100vw - 16px);
        height: calc(100vh - 16px);
        padding: 6px;
        border-radius: 14px;
      }
    }
  </style>
</head>
<body>

  <div class="frame-container">
    <div class="img-wrapper">
      <!-- Gambar disematkan langsung (Base64) -->
      <img src="https://mvlrfq.github.io/Wak/rhn.PNG" alt="Foto Profil" class="fullscreen-img">
    </div>
  </div>

</body>
</html>
